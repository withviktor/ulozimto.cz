# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides  ← sem patří TAJNÉ klíče
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme_generate_with_bin2hex_random_bytes_32
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://ulozimto.cz
###< symfony/routing ###

###> Domain configuration ###
MAIN_DOMAIN=ulozimto.cz
# Optional: set to a short domain like "uz.io" or "short.ulozimto.cz", or leave empty to disable
SHORT_DOMAIN=
# If true, short domain links redirect to main domain; if false, they stay on the short domain
REDIRECT_SHORT_TO_MAIN=false
###< Domain configuration ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:changeme@postgres:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

REDIS_URL=redis://redis:6379

MINIO_ENDPOINT=http://minio:9000
MINIO_KEY=changeme
MINIO_SECRET=changeme
MINIO_BUCKET=ulozimto
MINIO_REGION=us-east-1
UPLOAD_CHUNK_SIZE_MB=10
# Veřejná URL pro presigned linky — dev: localhost, prod: https://cdn.ulozimto.cz
MINIO_PUBLIC_URL=http://localhost:9000

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

###> resend ###
# Skutečné klíče jsou v .env.local (gitignorován)
RESEND_API_KEY=changeme
RESEND_AUDIENCE_ID=changeme
###< resend ###

###> mailer ###
MAILER_DSN=resend+api://changeme@default
MAILER_FROM=noreply@ulozimto.cz
MAILER_FROM_NAME=ulozimto.cz
###< mailer ###

###> symfony/resend-mailer ###
# MAILER_DSN=resend+api://API_KEY@default
# MAILER_DSN=resend+smtp://resend:API_KEY@default
###< symfony/resend-mailer ###
