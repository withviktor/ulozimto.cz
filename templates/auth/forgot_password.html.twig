{% extends 'base.html.twig' %}
{% block title %}Zapomenuté heslo — ulozimto.cz{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center flex-shrink-0">
                    <i data-lucide="key-round" class="w-5 h-5 text-indigo-600"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-gray-900">Zapomenuté heslo</h1>
                    <p class="text-xs text-gray-400">Zašleme ti odkaz pro obnovu</p>
                </div>
            </div>

            {% if sent %}
                <div class="flex items-start gap-3 bg-green-50 border border-green-200 rounded-xl px-4 py-4 mb-4">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="text-sm font-medium text-green-800">E-mail odeslán</p>
                        <p class="text-xs text-green-600 mt-1">
                            Pokud tento e-mail existuje v našem systému, obdržíš odkaz
                            pro obnovu hesla do minuty. Zkontroluj také složku se spamem.
                        </p>
                    </div>
                </div>
                <a href="{{ path('auth_login') }}"
                   class="block w-full text-center text-sm text-indigo-600 hover:underline mt-4">
                    Zpět na přihlášení
                </a>
            {% else %}
                <p class="text-sm text-gray-500 mb-5">
                    Zadej svůj e-mail a zašleme ti odkaz pro nastavení nového hesla.
                    Odkaz bude platný <strong>1 hodinu</strong>.
                </p>

                <form method="POST">
                    <div class="mb-5">
                        <label class="block text-xs text-gray-500 mb-1">E-mail</label>
                        <input type="email" name="email" autofocus required
                               class="w-full border border-gray-200 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                    </div>

                    <button type="submit"
                            class="w-full bg-indigo-600 text-white font-medium py-3 rounded-xl hover:bg-indigo-700 transition">
                        Odeslat odkaz
                    </button>
                </form>

                <p class="text-center text-sm text-gray-400 mt-6">
                    Vzpomněl(a) sis?
                    <a href="{{ path('auth_login') }}" class="text-indigo-600 hover:underline">Přihlásit se</a>
                </p>
            {% endif %}
        </div>
    </div>
{% endblock %}
