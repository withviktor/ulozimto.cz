{% extends 'base.html.twig' %}
{% block title %}Zkrácené linky — ulozimto.cz{% endblock %}

{% block body %}
<div x-data="shortLinksApp({{ stats|json_encode }})"
     x-init="init()"
     class="space-y-6">

    {# ── Hlavička ── #}
    <div class="flex flex-wrap gap-3 items-center justify-between">
        <h1 class="text-2xl font-bold">📎 Zkrácené linky</h1>
        <a href="{{ path('dashboard') }}"
           class="inline-flex items-center gap-2 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-300 transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Zpět na dashboard
        </a>
    </div>

    {# ── Quick Stats ── #}
    <div class="grid grid-cols-3 gap-4">
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
            <div class="text-sm text-gray-500 mb-1">Celkem linků</div>
            <div class="text-3xl font-bold text-indigo-600" x-text="stats.total">0</div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
            <div class="text-sm text-gray-500 mb-1">Celkem kliků</div>
            <div class="text-3xl font-bold text-green-600" x-text="stats.totalClicks">0</div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
            <div class="text-sm text-gray-500 mb-1">Populární</div>
            <div class="text-3xl font-bold text-orange-600" x-text="stats.mostPopular">0</div>
        </div>
    </div>

    {# ── Search & Filter ── #}
    <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
        <div class="flex flex-wrap gap-3">
            <input type="text"
                   x-model="search"
                   @input="loadShortLinks()"
                   placeholder="🔍 Hledat linky..."
                   class="flex-1 min-w-[200px] border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
            
            <select x-model="sortBy"
                    @change="loadShortLinks()"
                    class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white">
                <option value="created_desc">Nejnovější</option>
                <option value="created_asc">Nejstarší</option>
                <option value="clicks_desc">Nejvíce kliků</option>
                <option value="clicks_asc">Nejméně kliků</option>
                <option value="size_desc">Největší soubory</option>
                <option value="size_asc">Nejmenší soubory</option>
                <option value="expires_asc">Brzy expiruje</option>
            </select>

            <button @click="selectedLinks = []"
                    x-show="selectedLinks.length > 0"
                    class="px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition">
                Zrušit výběr
            </button>
            <button @click="bulkDelete()"
                    x-show="selectedLinks.length > 0"
                    class="px-3 py-2 text-sm bg-red-500 text-white rounded-lg hover:bg-red-600 transition">
                Smazat (<span x-text="selectedLinks.length"></span>)
            </button>
        </div>
    </div>

    {# ── Short Links Table ── #}
    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
        <div x-show="loading" class="p-6 text-center text-gray-500">
            <div class="inline-flex items-center gap-2">
                <i data-lucide="loader" class="w-4 h-4 animate-spin"></i>
                Načítám...
            </div>
        </div>

        <div x-show="!loading && shortLinks.length === 0" class="p-8 text-center">
            <i data-lucide="link-2" class="w-12 h-12 text-gray-300 mx-auto mb-3"></i>
            <p class="text-gray-500 mb-4">Zatím žádné zkrácené linky</p>
            <a href="{{ path('dashboard') }}"
               class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-700 font-medium">
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                Vytvořit linky v dashboardu
            </a>
        </div>

        <div x-show="!loading && shortLinks.length > 0" class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-left">
                            <input type="checkbox"
                                   @change="toggleSelectAll()"
                                   class="w-4 h-4 rounded border-gray-300 cursor-pointer">
                        </th>
                        <th class="px-4 py-3 text-left font-medium text-gray-700">Link</th>
                        <th class="px-4 py-3 text-left font-medium text-gray-700">Soubor</th>
                        <th class="px-4 py-3 text-center font-medium text-gray-700">Kliky</th>
                        <th class="px-4 py-3 text-left font-medium text-gray-700">Vytvořen</th>
                        <th class="px-4 py-3 text-left font-medium text-gray-700">Expiruje</th>
                        <th class="px-4 py-3 text-right font-medium text-gray-700">Akce</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <template x-for="link in shortLinks" :key="link.id">
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-4 py-3">
                                <input type="checkbox"
                                       :value="link.id"
                                       x-model="selectedLinks"
                                       class="w-4 h-4 rounded border-gray-300 cursor-pointer">
                            </td>
                            <td class="px-4 py-3">
                                <code class="bg-gray-100 px-2 py-1 rounded text-xs font-mono"
                                      x-text="link.slug"></code>
                            </td>
                            <td class="px-4 py-3">
                                <div class="text-gray-900" x-text="link.filename"></div>
                                <div class="text-xs text-gray-500" x-text="link.fileSize"></div>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">
                                    <i data-lucide="click" class="w-3 h-3"></i>
                                    <span x-text="link.clicks"></span>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-600" x-text="link.created"></td>
                            <td class="px-4 py-3">
                                <span class="text-xs"
                                      :class="link.expired ? 'text-red-600 font-medium' : 'text-gray-600'"
                                      x-text="link.expires"></span>
                            </td>
                            <td class="px-4 py-3 text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <button @click="copyToClipboard(link.shortUrl)"
                                            title="Kopírovat"
                                            class="p-1.5 hover:bg-blue-100 rounded transition">
                                        <i data-lucide="copy" class="w-4 h-4 text-blue-600"></i>
                                    </button>
                                    <button @click="showQRCode(link.id)"
                                            title="QR kód"
                                            class="p-1.5 hover:bg-purple-100 rounded transition">
                                        <i data-lucide="qr-code" class="w-4 h-4 text-purple-600"></i>
                                    </button>
                                    <button @click="regenerateSlug(link.id)"
                                            title="Obnovit"
                                            class="p-1.5 hover:bg-orange-100 rounded transition">
                                        <i data-lucide="refresh-cw" class="w-4 h-4 text-orange-600"></i>
                                    </button>
                                    <button @click="deleteLink(link.id)"
                                            title="Smazat"
                                            class="p-1.5 hover:bg-red-100 rounded transition">
                                        <i data-lucide="trash-2" class="w-4 h-4 text-red-600"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        {# ── Pagination ── #}
        <div x-show="!loading && pagination.pages > 1"
             class="px-4 py-4 border-t border-gray-100 flex items-center justify-between bg-gray-50">
            <div class="text-sm text-gray-600">
                Zobrazuju <strong x-text="(pagination.page - 1) * pagination.limit + 1"></strong>
                až
                <strong x-text="Math.min(pagination.page * pagination.limit, pagination.total)"></strong>
                z
                <strong x-text="pagination.total"></strong>
            </div>
            <div class="flex gap-2">
                <button @click="page--; loadShortLinks()"
                        :disabled="page === 1"
                        class="px-3 py-1 text-sm border border-gray-200 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition">
                    ←
                </button>
                <span class="px-3 py-1 text-sm" x-text="`Strana ${page} z ${pagination.pages}`"></span>
                <button @click="page++; loadShortLinks()"
                        :disabled="page === pagination.pages"
                        class="px-3 py-1 text-sm border border-gray-200 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition">
                    →
                </button>
            </div>
        </div>
    </div>

</div>

{# ── QR Code Modal ── #}
<div x-show="showQRModal"
     x-transition
     class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
     @click.self="showQRModal = false">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold">QR kód</h2>
            <button @click="showQRModal = false"
                    class="p-1 hover:bg-gray-100 rounded transition">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <img :src="qrCodeImage"
                 alt="QR Code"
                 class="w-full">
        </div>

        <input type="text"
               :value="qrCodeUrl"
               readonly
               class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm mb-4 focus:outline-none">

        <div class="flex gap-2">
            <button @click="copyToClipboard(qrCodeUrl)"
                    class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition font-medium text-sm">
                📋 Kopírovat
            </button>
            <button @click="downloadQRCode()"
                    class="flex-1 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition font-medium text-sm">
                ⬇️ Stáhnout
            </button>
        </div>
    </div>
</div>

{# ── Delete Confirmation ── #}
<div x-show="showDeleteModal"
     x-transition
     class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
     @click.self="showDeleteModal = false">
    <div class="bg-white rounded-lg shadow-xl p-6 max-w-sm w-full mx-4">
        <h2 class="text-lg font-bold mb-2">Smazat zkrácený link?</h2>
        <p class="text-gray-600 mb-6">Tato akce je nevratná.</p>

        <div class="flex gap-2">
            <button @click="showDeleteModal = false"
                    class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition font-medium">
                Zrušit
            </button>
            <button @click="confirmDelete()"
                    class="flex-1 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-medium">
                Smazat
            </button>
        </div>
    </div>
</div>

{# ── Success Toast ── #}
<div x-show="showToast"
     x-transition
     class="fixed bottom-6 right-6 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg z-50"
     @click="showToast = false">
    <div class="flex items-center gap-2">
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span x-text="toastMessage"></span>
    </div>
</div>

<script>
function shortLinksApp(initialStats) {
    return {
        shortLinks: [],
        stats: initialStats,
        search: '',
        sortBy: 'created_desc',
        page: 1,
        pagination: { total: 0, page: 1, limit: 20, pages: 1 },
        loading: true,
        selectedLinks: [],
        showQRModal: false,
        showDeleteModal: false,
        showToast: false,
        toastMessage: '',
        qrCodeImage: '',
        qrCodeUrl: '',
        deleteId: null,

        async init() {
            await this.loadShortLinks();
            this.$watch('search', () => {
                this.page = 1;
                this.loadShortLinks();
            });
        },

        async loadShortLinks() {
            this.loading = true;
            try {
                const params = new URLSearchParams({
                    search: this.search,
                    sort: this.sortBy,
                    page: this.page,
                });
                const response = await fetch(`/api/dashboard/short-links?${params}`);
                const data = await response.json();
                this.shortLinks = data.data;
                this.pagination = data.pagination;
                this.stats.total = data.pagination.total;
                // Recalculate total clicks
                this.stats.totalClicks = this.shortLinks.reduce((sum, link) => sum + link.clicks, 0);
                this.stats.mostPopular = this.shortLinks.length > 0 ? Math.max(...this.shortLinks.map(l => l.clicks)) : 0;
            } catch (error) {
                console.error('Error loading short links:', error);
                this.showMessage('Chyba při načítání');
            }
            this.loading = false;
        },

        async copyToClipboard(url) {
            try {
                await navigator.clipboard.writeText(url);
                this.toastMessage = 'Zkopírováno do schránky!';
                this.showToast = true;
                setTimeout(() => this.showToast = false, 2000);
            } catch (error) {
                console.error('Failed to copy:', error);
            }
        },

        async showQRCode(linkId) {
            try {
                const link = this.shortLinks.find(l => l.id === linkId);
                if (!link) return;
                
                this.qrCodeUrl = link.shortUrl;
                const response = await fetch(`/api/dashboard/short-links/${linkId}/qrcode`);
                const blob = await response.blob();
                this.qrCodeImage = URL.createObjectURL(blob);
                this.showQRModal = true;
            } catch (error) {
                console.error('Error generating QR code:', error);
                this.showMessage('Chyba při generování QR kódu');
            }
        },

        async downloadQRCode() {
            const a = document.createElement('a');
            a.href = this.qrCodeImage;
            a.download = `qrcode-${Date.now()}.png`;
            a.click();
        },

        async regenerateSlug(linkId) {
            if (!confirm('Opravdu obnovit slug? Starý link bude fungovat dál.')) return;

            try {
                const response = await fetch(`/api/dashboard/short-links/${linkId}/regenerate`, {
                    method: 'POST',
                });
                if (response.ok) {
                    await this.loadShortLinks();
                    this.toastMessage = 'Slug obnoven!';
                    this.showToast = true;
                    setTimeout(() => this.showToast = false, 2000);
                }
            } catch (error) {
                console.error('Error regenerating slug:', error);
                this.showMessage('Chyba při obnovení');
            }
        },

        deleteLink(linkId) {
            this.deleteId = linkId;
            this.showDeleteModal = true;
        },

        async confirmDelete() {
            if (!this.deleteId) return;
            try {
                const response = await fetch(`/api/dashboard/short-links/${this.deleteId}`, {
                    method: 'DELETE',
                });
                if (response.ok) {
                    this.showDeleteModal = false;
                    await this.loadShortLinks();
                    this.toastMessage = 'Link smazán';
                    this.showToast = true;
                    setTimeout(() => this.showToast = false, 2000);
                }
            } catch (error) {
                console.error('Error deleting link:', error);
                this.showMessage('Chyba při mazání');
            }
        },

        async bulkDelete() {
            if (!confirm(`Smazat ${this.selectedLinks.length} linků?`)) return;

            try {
                const response = await fetch('/api/dashboard/short-links/bulk-delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: this.selectedLinks }),
                });
                if (response.ok) {
                    this.selectedLinks = [];
                    await this.loadShortLinks();
                    this.toastMessage = 'Linky smazány';
                    this.showToast = true;
                    setTimeout(() => this.showToast = false, 2000);
                }
            } catch (error) {
                console.error('Error bulk deleting:', error);
                this.showMessage('Chyba při mazání');
            }
        },

        toggleSelectAll() {
            if (this.selectedLinks.length === this.shortLinks.length) {
                this.selectedLinks = [];
            } else {
                this.selectedLinks = this.shortLinks.map(l => l.id);
            }
        },

        showMessage(msg) {
            this.toastMessage = msg;
            this.showToast = true;
            setTimeout(() => this.showToast = false, 3000);
        },
    };
}
</script>
{% endblock %}
