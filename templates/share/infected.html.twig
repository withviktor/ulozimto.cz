{% extends 'base.html.twig' %}
{% block title %}Soubor blokován — ulozimto.cz{% endblock %}

{% block body %}
<div class="max-w-md mx-auto text-center">
    <div class="bg-white rounded-2xl shadow-sm border border-red-200 p-10">
        <div class="flex justify-center mb-5">
            <i data-lucide="shield-x" class="w-16 h-16 text-red-500"></i>
        </div>
        <h1 class="text-xl font-bold text-red-600 mb-2">Soubor byl blokován</h1>
        <p class="text-sm text-gray-500 mb-1">
            Antivirový skener detekoval hrozbu v souboru
            <span class="font-medium text-gray-700">{{ file.originalName }}</span>.
        </p>
        <p class="text-sm text-gray-400 mt-4">
            Soubor byl z bezpečnostních důvodů odstraněn a není dostupný ke stažení.
        </p>
        <a href="{{ path('upload_index') }}"
           class="inline-flex items-center gap-2 mt-6 text-sm text-indigo-600 hover:underline">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Zpět na hlavní stránku
        </a>
    </div>
</div>
{% endblock %}
