{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}
{% block title %}{{ file.originalName }} — ulozimto.cz{% endblock %}

{% block meta %}
    {% set ownerName = file.user ? file.user.displayName ~ ' sdílel(a) soubor' : 'Někdo ti sdílel soubor' %}
    {% set remaining = expiration.getRemainingLabel(file.expiresAt) %}

    <meta property="og:title"       content="{{ ownerName }}: {{ file.originalName }}">
    <meta property="og:description" content="{{ file.formattedSize }} · {{ remaining }} · Stáhni na ulozimto.cz">
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="ulozimto.cz">
    <meta property="og:url"         content="{{ app.request.uri }}">

    {% if file.clean and file.mimeType starts with 'image/' %}
        <meta property="og:image" content="{{ absolute_url(path('share_preview', {token: file.shareToken})) }}">
        <meta name="twitter:card"  content="summary_large_image">
    {% else %}
        <meta property="og:image" content="{{ absolute_url(asset('img/og-default.png')) }}">
        <meta name="twitter:card"  content="summary">
    {% endif %}

    <meta name="twitter:title"       content="{{ ownerName }}: {{ file.originalName }}">
    <meta name="twitter:description" content="{{ file.formattedSize }} · {{ remaining }} · ulozimto.cz">
{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto"
     x-data="sharePage('{{ file.scanStatus }}', '{{ file.shareToken }}', '{{ file.mimeType|e('js') }}')"
     x-init="init()">

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">

        {# ── Preview sekce — řízena Alpine ── #}

        {# Obrázek #}
        <template x-if="scanStatus === 'clean' && isImage">
            <div class="bg-gray-100 flex items-center justify-center p-4 max-h-96 overflow-hidden">
                <img :src="previewUrl"
                     alt="{{ file.originalName|e('html_attr') }}"
                     class="max-h-80 max-w-full rounded-lg object-contain shadow-sm">
            </div>
        </template>

        {# Video #}
        <template x-if="scanStatus === 'clean' && isVideo">
            <div class="bg-black">
                <video :src="previewUrl"
                       controls
                       preload="metadata"
                       class="w-full max-h-96 object-contain">
                    Váš prohlížeč nepodporuje přehrávání videa.
                </video>
            </div>
        </template>

        {# Ostatní soubory / čeká na sken — velká ikona #}
        <template x-if="scanStatus !== 'clean' || (!isImage && !isVideo)">
            <div class="flex items-center justify-center py-12 bg-gray-50">
                {{ macros.fileIcon(file.mimeType, 'w-20 h-20') }}
            </div>
        </template>

        {# ── Scan status banner — živý ── #}
        <div class="px-6 pt-5 pb-0">

            {# Pending #}
            <div x-show="scanStatus === 'pending'"
                 class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm text-amber-700 mb-4">
                <span class="relative flex-shrink-0">
                    <i data-lucide="shield" class="w-5 h-5"></i>
                    <span class="absolute inset-0 animate-ping rounded-full bg-amber-400 opacity-30"></span>
                </span>
                <span>
                    Skenování na viry probíhá…
                    <span class="font-mono font-medium" x-text="elapsed + 's'"></span>
                </span>
                <span class="ml-auto flex gap-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce" style="animation-delay:0ms"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce" style="animation-delay:150ms"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-bounce" style="animation-delay:300ms"></span>
                </span>
            </div>

            {# Clean #}
            <div x-show="scanStatus === 'clean'" x-cloak
                 class="flex items-center gap-2 bg-green-50 border border-green-200 rounded-xl px-4 py-2.5 text-sm text-green-700 mb-4">
                <i data-lucide="shield-check" class="w-4 h-4 flex-shrink-0"></i>
                Soubor prošel antivirovým skenem — je bezpečný.
            </div>

            {# Infected #}
            <div x-show="scanStatus === 'infected'" x-cloak
                 class="flex items-center gap-2 bg-red-50 border border-red-200 rounded-xl px-4 py-2.5 text-sm text-red-700 mb-4">
                <i data-lucide="shield-x" class="w-4 h-4 flex-shrink-0"></i>
                Hrozba detekována — soubor byl zablokován a odstraněn.
            </div>

            {# Error — fail open #}
            <div x-show="scanStatus === 'error'" x-cloak
                 class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-gray-500 mb-4">
                <i data-lucide="shield-alert" class="w-4 h-4 flex-shrink-0"></i>
                Antivirový sken selhal — soubor je dostupný.
            </div>

        </div>

        {# ── Info o souboru ── #}
        <div class="px-6 pb-6">
            <div class="flex items-start gap-3 mb-5">
                <div class="flex-shrink-0 mt-0.5">
                    {{ macros.fileIcon(file.mimeType, 'w-5 h-5') }}
                </div>
                <div class="min-w-0">
                    <h1 class="text-lg font-semibold break-all leading-snug">{{ file.originalName }}</h1>
                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-400 mt-1">
                        <span>{{ file.formattedSize }}</span>
                        <span>staženo {{ file.downloadCount }}×</span>
                        <span class="{{ file.expired ? 'text-red-400' : '' }}">
                            {{ expiration.getRemainingLabel(file.expiresAt) }}
                        </span>
                    </div>
                </div>
                {% if file.passwordProtected %}
                    <span class="ml-auto flex-shrink-0">
                        <i data-lucide="lock" class="w-4 h-4 text-gray-400"></i>
                    </span>
                {% endif %}
            </div>

            {# Stažení — dostupné jen pokud clean #}
            <a x-show="scanStatus === 'clean' || scanStatus === 'error'" x-cloak
               href="{{ path('share_download', { token: file.shareToken }) }}"
               class="flex items-center justify-center gap-2 w-full bg-indigo-600 text-white
                      font-medium py-3 px-6 rounded-xl hover:bg-indigo-700 active:scale-[.98] transition">
                <i data-lucide="download" class="w-5 h-5"></i>
                Stáhnout soubor
            </a>

            {# Pending — disabled #}
            <button x-show="scanStatus === 'pending'"
                    disabled
                    class="flex items-center justify-center gap-2 w-full bg-gray-100 text-gray-400
                           font-medium py-3 px-6 rounded-xl cursor-not-allowed">
                <i data-lucide="shield" class="w-5 h-5"></i>
                Čekám na výsledek skenování…
            </button>

            {# Infected — blokováno #}
            <div x-show="scanStatus === 'infected'" x-cloak
                 class="flex items-center justify-center gap-2 w-full bg-red-50 text-red-400
                        font-medium py-3 px-6 rounded-xl border border-red-200">
                <i data-lucide="shield-x" class="w-5 h-5"></i>
                Stažení není dostupné
            </div>

            <p class="text-xs text-gray-300 text-center mt-3">
                Platnost do {{ file.expiresAt|date('j. n. Y') }}
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block page_scripts %}
<script>
function sharePage(initialStatus, token, mimeType) {
    return {
        scanStatus: initialStatus,
        elapsed: 0,
        previewUrl: `/s/${token}/preview`,
        _timer: null,
        _poller: null,

        get isImage() { return mimeType.startsWith('image/'); },
        get isVideo() { return mimeType.startsWith('video/'); },

        init() {
            if (this.scanStatus !== 'pending') return;
            // Sekundoměr
            this._timer = setInterval(() => this.elapsed++, 1000);
            // Polling
            this._poller = setInterval(async () => {
                try {
                    const res = await fetch(`/s/${token}/status`);
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.status !== 'pending') {
                        this.scanStatus = data.status;
                        clearInterval(this._timer);
                        clearInterval(this._poller);
                        this.$nextTick(() => lucide.createIcons());
                    }
                } catch (_) {}
            }, 2000);
        },
    };
}
</script>
{% endblock %}
