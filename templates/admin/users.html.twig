{% extends 'admin/layout.html.twig' %}
{% block title %}Uživatelé — Admin — ulozimto.cz{% endblock %}

{% block admin_body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Uživatelé</h1>
    <span class="text-sm text-gray-400">Celkem: {{ total }}</span>
</div>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
            <tr>
                <th class="px-4 py-3 text-left">E-mail</th>
                <th class="px-4 py-3 text-center">Plán</th>
                <th class="px-4 py-3 text-center">Soubory</th>
                <th class="px-4 py-3 text-center">Registrace</th>
                <th class="px-4 py-3 text-right">Akce</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
        {% for user in users %}
            <tr class="hover:bg-gray-50 transition-colors"
                x-data="planRow('{{ user.id }}', '{{ user.plan }}')">
                <td class="px-4 py-3">
                    <a href="{{ path('admin_user_detail', {id: user.id}) }}"
                       class="font-medium hover:text-indigo-600 transition">{{ user.email }}</a>
                    {% if user.name %}<span class="text-gray-400 text-xs ml-1">· {{ user.name }}</span>{% endif %}
                    {% if 'ROLE_ADMIN' in user.roles %}<span class="ml-1 text-xs bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded-full font-medium">admin</span>{% endif %}
                </td>

                <td class="px-4 py-3 text-center">
                    <button @click="toggle()" :disabled="loading"
                            :class="plan === 'plus' ? 'bg-indigo-100 text-indigo-700 hover:bg-gray-100 hover:text-gray-600' : 'bg-gray-100 text-gray-500 hover:bg-indigo-50 hover:text-indigo-600'"
                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium transition disabled:opacity-50"
                            :title="plan === 'plus' ? 'Přepnout na Free' : 'Přepnout na PLUS'">
                        <i :data-lucide="plan === 'plus' ? 'zap' : 'user'" class="w-3 h-3"></i>
                        <span x-text="plan === 'plus' ? 'PLUS' : 'Free'"></span>
                    </button>
                </td>

                <td class="px-4 py-3 text-center text-gray-500">{{ user.files|length }}</td>
                <td class="px-4 py-3 text-center text-gray-400 text-xs">{{ user.createdAt|date('j. n. Y') }}</td>

                <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-2">
                        <a href="{{ path('admin_user_detail', {id: user.id}) }}"
                           class="text-gray-400 hover:text-indigo-500 transition" title="Detail">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                        </a>
                        <form method="POST" action="{{ path('admin_delete_user', {id: user.id}) }}"
                              onsubmit="return confirm('Opravdu smazat uživatele a všechna jeho data?')">
                            <button type="submit" class="text-gray-400 hover:text-red-500 transition" title="Smazat">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% if pages > 1 %}
<div class="flex justify-center gap-2 mt-6">
    {% for p in 1..pages %}
    <a href="{{ path('admin_users', {page: p}) }}"
       class="w-8 h-8 flex items-center justify-center rounded-lg text-sm
              {{ p == page ? 'bg-indigo-600 text-white' : 'bg-white border border-gray-200 text-gray-600 hover:border-indigo-300' }}">
        {{ p }}
    </a>
    {% endfor %}
</div>
{% endif %}

{% endblock %}

{% block page_scripts %}
<script>
function planRow(userId, initialPlan) {
    return {
        plan: initialPlan,
        loading: false,
        async toggle() {
            this.loading = true;
            const newPlan = this.plan === 'plus' ? 'free' : 'plus';
            const form = new FormData();
            form.append('plan', newPlan);
            const res = await fetch(`/admin/users/${userId}/set-plan`, { method: 'POST', body: form });
            if (res.ok) {
                this.plan = newPlan;
                this.$nextTick(() => lucide.createIcons());
            }
            this.loading = false;
        },
    };
}
</script>
{% endblock %}
