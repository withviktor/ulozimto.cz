<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ulozimto.cz{% endblock %}</title>
    <link rel="icon" type="image/x-icon"       href="{{ asset('img/favicon.ico') }}">
    <link rel="icon" type="image/png" sizes="16x16"  href="{{ asset('img/favicon-16x16.png') }}">
    <link rel="icon" type="image/png" sizes="32x32"  href="{{ asset('img/favicon-32x32.png') }}">
    <link rel="apple-touch-icon" sizes="180x180"     href="{{ asset('img/apple-touch-icon.png') }}">
    <link rel="manifest"                             href="{{ asset('site.webmanifest') }}">
    <meta name="theme-color" content="#4f46e5">

    {# ── OG / Social meta tagy — přepsatelné v každé stránce ── #}
    {% block meta %}
        <meta property="og:site_name"  content="ulozimto.cz">
        <meta property="og:type"       content="website">
        <meta property="og:title"      content="ulozimto.cz — Sdílení souborů">
        <meta property="og:description" content="Sdílej soubory jednoduše a rychle — fotky, videa, archivy.">
        <meta name="twitter:card"      content="summary">
    {% endblock %}

    {% block javascripts %}{% endblock %}
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col">

<nav class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="{{ path('homepage') }}" class="text-xl font-bold text-indigo-600 tracking-tight">
            ulozimto<span class="text-gray-400">.cz</span>
        </a>
        <div class="flex items-center gap-3 text-sm">
            {% if app.user %}
                <a href="{{ path('dashboard') }}"
                   class="text-gray-600 hover:text-indigo-600 transition">
                    Moje soubory
                </a>

                {# Avatar dropdown #}
                <div class="relative" x-data="{ open: false }">
                    <button @click="open = !open" @keydown.escape="open = false"
                            class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-lg hover:bg-gray-100 transition">
                        <img src="{{ avatarService.getAvatarUrl(app.user, 32) }}"
                             alt="Avatar"
                             class="w-7 h-7 rounded-full object-cover border border-gray-200">
                        <span class="text-gray-700 font-medium max-w-[120px] truncate">
                            {{ app.user.displayName }}
                        </span>
                        <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-400"></i>
                    </button>

                    <div x-show="open"
                         x-cloak
                         @click.outside="open = false"
                         class="absolute right-0 top-full mt-1 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-50">
                        <a href="{{ path('profile') }}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                            <i data-lucide="user" class="w-4 h-4 text-gray-400"></i>
                            Profil
                        </a>
                        <a href="{{ path('dashboard') }}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
                            <i data-lucide="folder" class="w-4 h-4 text-gray-400"></i>
                            Moje soubory
                        </a>
                        <hr class="my-1 border-gray-100">
                        <a href="{{ path('auth_logout') }}"
                           class="flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-50">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                            Odhlásit
                        </a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('auth_login') }}" class="text-gray-600 hover:text-indigo-600 transition">
                    Přihlásit
                </a>
                <a href="{{ path('auth_register') }}"
                   class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg hover:bg-indigo-700 transition text-sm font-medium">
                    Registrace
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="flex-1 max-w-5xl mx-auto w-full px-4 py-10">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-3 rounded-lg text-sm flex items-start gap-2
                    {% if type == 'success' %}bg-green-50 text-green-800 border border-green-200
                    {% elseif type == 'error' %}bg-red-50 text-red-800 border border-red-200
                    {% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %}">
                <i data-lucide="{% if type == 'success' %}check-circle-2{% elseif type == 'error' %}alert-circle{% else %}info{% endif %}"
                   class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="text-center text-xs text-gray-400 py-5 border-t border-gray-100">
    <p class="mb-1">ulozimto.cz — Sdílení souborů zdarma</p>
    <div class="flex items-center justify-center gap-4">
        <a href="{{ path('legal_terms') }}"   class="hover:text-gray-600 transition">Podmínky použití</a>
        <span class="text-gray-200">·</span>
        <a href="{{ path('legal_privacy') }}" class="hover:text-gray-600 transition">Ochrana osobních údajů</a>
        <span class="text-gray-200">·</span>
        <a href="{{ path('upload_index') }}"  class="hover:text-gray-600 transition">Nahrát soubor</a>
    </div>
</footer>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => lucide.createIcons());
</script>
{% block page_scripts %}{% endblock %}

{# ── PLUS Coming Soon Modal ──────────────────────────────────────── #}
<div x-data="plusModal()"
     x-init="init()"
     @show-plus-modal.window="open()"
     @keydown.escape.window="close()">

    {# Backdrop #}
    <div x-show="isOpen"
         x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @click="close()"
         class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40">
    </div>

    {# Modal #}
    <div x-show="isOpen"
         x-cloak
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100"
         x-transition:leave-end="opacity-0 scale-95"
         class="fixed inset-0 flex items-center justify-center z-50 p-4 pointer-events-none">

        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md pointer-events-auto" @click.stop>

            {# Hlavička #}
            <div class="flex items-start justify-between p-6 pb-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="zap" class="w-5 h-5 text-indigo-600"></i>
                    </div>
                    <div>
                        <h2 class="font-bold text-gray-900">PLUS účty — již brzy</h2>
                        <p class="text-xs text-gray-400">Zaregistruj se pro první upozornění</p>
                    </div>
                </div>
                <button @click="close()"
                        class="text-gray-400 hover:text-gray-600 transition ml-4 flex-shrink-0">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            {# Obsah #}
            <div class="px-6 pb-6">
                <p class="text-sm text-gray-600 mb-5">
                    Pracujeme na PLUS plánech s&nbsp;větším úložištěm, delší expirací a&nbsp;vlastními URL.
                    Zatím jsou dostupné pouze účty zdarma.
                    Zanech nám email a&nbsp;dáme ti vědět jako prvním.
                </p>

                {# Formulář — zobrazí se dokud není odesláno #}
                <div x-show="!sent">
                    <div class="flex gap-2">
                        <input type="email"
                               x-model="email"
                               @keydown.enter="submit()"
                               placeholder="tvuj@email.cz"
                               class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm
                                      focus:outline-none focus:ring-2 focus:ring-indigo-400"
                               :disabled="loading">
                        <button @click="submit()"
                                :disabled="loading || !email"
                                class="bg-indigo-600 text-white px-4 py-2.5 rounded-xl text-sm font-medium
                                       hover:bg-indigo-700 disabled:opacity-50 transition flex-shrink-0
                                       flex items-center gap-1.5">
                            <span x-show="!loading">Notifikovat mě</span>
                            <span x-show="loading" x-cloak class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                </svg>
                                Ukládám…
                            </span>
                        </button>
                    </div>

                    <p x-show="error" x-cloak
                       class="text-xs text-red-500 mt-2"
                       x-text="error"></p>
                </div>

                {# Potvrzení po odeslání #}
                <div x-show="sent" x-cloak
                     class="flex items-center gap-3 bg-green-50 border border-green-200 rounded-xl px-4 py-3">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-green-600 flex-shrink-0"></i>
                    <div>
                        <p class="text-sm font-medium text-green-800">Zaregistrováno!</p>
                        <p class="text-xs text-green-600 mt-0.5">Dáme ti vědět, jakmile PLUS spustíme.</p>
                    </div>
                </div>

                <button @click="close()"
                        class="w-full mt-4 text-sm text-gray-400 hover:text-gray-600 transition py-1">
                    Zavřít
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function plusModal() {
    return {
        isOpen: false,
        email:  '{{ app.user ? app.user.email|e('js') : '' }}',
        loading: false,
        sent:    false,
        error:   '',

        init() {
            // Poslouchat globální event
        },

        open() {
            this.isOpen = true;
            this.sent   = false;
            this.error  = '';
            this.$nextTick(() => lucide.createIcons());
        },

        close() {
            this.isOpen = false;
        },

        async submit() {
            if (!this.email) return;
            this.loading = true;
            this.error   = '';

            try {
                const res = await fetch('/api/plus-notify', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ email: this.email }),
                });
                const data = await res.json();

                if (!res.ok) {
                    this.error = data.error ?? 'Něco se pokazilo, zkus to znovu.';
                } else {
                    this.sent = true;
                    this.$nextTick(() => lucide.createIcons());
                }
            } catch (_) {
                this.error = 'Síťová chyba. Zkus to prosím znovu.';
            } finally {
                this.loading = false;
            }
        },
    };
}
</script>

</body>
</html>
