{% extends 'base.html.twig' %}

{% block title %}ulozimto.cz — Nahrávej a sdílej soubory zdarma{% endblock %}

{% block meta %}
    <meta property="og:site_name"   content="ulozimto.cz">
    <meta property="og:type"        content="website">
    <meta property="og:title"       content="ulozimto.cz — Nahrávej a sdílej soubory zdarma">
    <meta property="og:description" content="Fotky, videa, ZIPy, celé složky — bez registrace, bez omezení velikosti. Antivirový sken každého souboru.">
    <meta property="og:image"       content="{{ absolute_url(asset('img/og-default.png')) }}">
    <meta name="twitter:card"       content="summary_large_image">
    <meta name="description"        content="Nahrávej a sdílej soubory zdarma na ulozimto.cz. Bez registrace, bez omezení, s antivirovým skenem.">
{% endblock %}

{% block body %}

{# ═══════════════════════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════════════════════ #}
<section class="text-center py-20 px-4">
    <div class="inline-flex items-center gap-2 bg-indigo-50 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-indigo-100">
        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
        Antivirový sken každého souboru
    </div>

    <h1 class="text-5xl font-extrabold text-gray-900 leading-tight mb-4 max-w-2xl mx-auto">
        Nahrávej a&nbsp;sdílej<br>
        <span class="text-indigo-600">soubory snadno</span>
    </h1>
    <p class="text-lg text-gray-500 max-w-xl mx-auto mb-10">
        Fotky, videa, ZIPy, celé složky — bez registrace, bez omezení velikosti.<br>
        Sdílej jedním odkazem.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="{{ path('upload_index') }}"
           class="inline-flex items-center gap-2 bg-indigo-600 text-white font-semibold px-8 py-3.5 rounded-2xl hover:bg-indigo-700 active:scale-95 transition-all shadow-sm shadow-indigo-200 text-base">
            <i data-lucide="upload-cloud" class="w-5 h-5"></i>
            Nahrát soubor
        </a>
        {% if not app.user %}
        <a href="{{ path('auth_register') }}"
           class="inline-flex items-center gap-2 bg-white text-gray-700 font-medium px-6 py-3.5 rounded-2xl hover:bg-gray-50 border border-gray-200 transition-all text-base">
            <i data-lucide="user-plus" class="w-5 h-5 text-gray-400"></i>
            Vytvořit účet zdarma
        </a>
        {% endif %}
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   RYCHLÝ PŘEHLED LIMITŮ
═══════════════════════════════════════════════════════════════════ #}
<section class="max-w-3xl mx-auto px-4 mb-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center shadow-sm">
            <div class="text-2xl font-bold text-indigo-600 mb-1">2 GB</div>
            <div class="text-xs text-gray-500">Max. soubor (free)</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center shadow-sm">
            <div class="text-2xl font-bold text-indigo-600 mb-1">10 GB</div>
            <div class="text-xs text-gray-500">Celkové úložiště (free)</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center shadow-sm">
            <div class="text-2xl font-bold text-indigo-600 mb-1">90 dní</div>
            <div class="text-xs text-gray-500">Maximální platnost (free)</div>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 text-center shadow-sm">
            <div class="text-2xl font-bold text-green-600 mb-1">0 Kč</div>
            <div class="text-xs text-gray-500">Cena za základní plán</div>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   FUNKCE
═══════════════════════════════════════════════════════════════════ #}
<section class="max-w-4xl mx-auto px-4 mb-20">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-10">Proč ulozimto.cz?</h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="upload-cloud" class="w-5 h-5 text-indigo-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Chunked upload</h3>
            <p class="text-sm text-gray-500">Soubory se nahrávají po částech — přerušení nebo velký soubor není problém. Limit? Žádný.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="shield-check" class="w-5 h-5 text-green-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Antivirový sken</h3>
            <p class="text-sm text-gray-500">Každý soubor prochází ClamAV skenem. Infikované soubory jsou automaticky blokovány a odstraněny.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="folder-up" class="w-5 h-5 text-purple-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Nahrání složky</h3>
            <p class="text-sm text-gray-500">Přetáhni celou složku — server ji automaticky zazipuje a vytvoří jeden sdílitelný odkaz.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="lock" class="w-5 h-5 text-amber-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Ochrana heslem</h3>
            <p class="text-sm text-gray-500">Nastav heslo a sdílej jen s těmi, komu ho dáš. Soubor jinak nikdo nenajde ani nestáhne.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-sky-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="image" class="w-5 h-5 text-sky-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Náhled v prohlížeči</h3>
            <p class="text-sm text-gray-500">Obrázky a videa lze rovnou prohlížet — příjemce nemusí nic stahovat, aby viděl, o co jde.</p>
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
            <div class="w-10 h-10 bg-rose-50 rounded-xl flex items-center justify-center mb-4">
                <i data-lucide="clock" class="w-5 h-5 text-rose-600"></i>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Platnost souboru</h3>
            <p class="text-sm text-gray-500">Zvol, jak dlouho má soubor být dostupný — od hodiny po 90 dní (free) nebo 365 dní (PLUS).</p>
        </div>

    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   CENÍK
═══════════════════════════════════════════════════════════════════ #}
<section class="max-w-3xl mx-auto px-4 mb-20">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-3">Plány</h2>
    <p class="text-center text-gray-500 text-sm mb-10">Začni zdarma, PLUS je na cestě.</p>

    <div class="grid sm:grid-cols-2 gap-6">

        {# FREE #}
        <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Free</h3>
                    <p class="text-sm text-gray-400">Pro každého, bez registrace</p>
                </div>
                <div class="text-right">
                    <span class="text-3xl font-extrabold text-gray-900">0</span>
                    <span class="text-gray-400 text-sm"> Kč/měsíc</span>
                </div>
            </div>
            <ul class="space-y-3 text-sm text-gray-600 mb-8">
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Max. soubor <strong>2 GB</strong>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Celkové úložiště <strong>10 GB</strong> (po registraci)
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Platnost souboru až <strong>90 dní</strong>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Antivirový sken
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Ochrana heslem
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-green-500 flex-shrink-0"></i>
                    Náhled obrázků a videí
                </li>
            </ul>
            <a href="{{ path('upload_index') }}"
               class="block text-center bg-gray-900 text-white font-medium py-3 rounded-xl hover:bg-gray-800 transition">
                Nahrát soubor
            </a>
        </div>

        {# PLUS #}
        <div class="bg-indigo-600 rounded-2xl p-8 shadow-lg relative overflow-hidden">
            <div class="absolute top-4 right-4 bg-indigo-500 text-indigo-100 text-xs font-semibold px-2.5 py-1 rounded-full">
                Brzy
            </div>
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        PLUS
                    </h3>
                    <p class="text-sm text-indigo-200">Pro náročné uživatele</p>
                </div>
                <div class="text-right">
                    <span class="text-3xl font-extrabold text-white">?</span>
                    <span class="text-indigo-200 text-sm"> Kč/měsíc</span>
                </div>
            </div>
            <ul class="space-y-3 text-sm text-indigo-100 mb-8">
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    Max. soubor <strong class="text-white">20 GB</strong>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    Celkové úložiště <strong class="text-white">200 GB</strong>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    Platnost souboru až <strong class="text-white">365 dní</strong>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    <strong class="text-white">Prioritní</strong> antivirový sken
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    <strong class="text-white">Vlastní URL</strong> (/s/muj-soubor)
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4 text-indigo-300 flex-shrink-0"></i>
                    Vše z Free plánu
                </li>
            </ul>
            <button @click="$dispatch('show-plus-modal')"
                    class="w-full bg-white text-indigo-700 font-semibold py-3 rounded-xl hover:bg-indigo-50 transition">
                Upozorni mě na spuštění
            </button>
        </div>

    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   JAK TO FUNGUJE
═══════════════════════════════════════════════════════════════════ #}
<section class="max-w-3xl mx-auto px-4 mb-20">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-10">Jak to funguje?</h2>

    <div class="grid sm:grid-cols-3 gap-6 text-center">
        <div>
            <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <span class="text-xl font-bold text-indigo-600">1</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Nahraj</h3>
            <p class="text-sm text-gray-500">Přetáhni soubor nebo složku do okna — nebo klikni pro výběr.</p>
        </div>
        <div>
            <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <span class="text-xl font-bold text-indigo-600">2</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Nastav</h3>
            <p class="text-sm text-gray-500">Zvol platnost, přidej heslo a vlastní URL (PLUS).</p>
        </div>
        <div>
            <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <span class="text-xl font-bold text-indigo-600">3</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Sdílej</h3>
            <p class="text-sm text-gray-500">Zkopíruj odkaz a pošli komu chceš — žádná registrace příjemce.</p>
        </div>
    </div>
</section>

{# ═══════════════════════════════════════════════════════════════════
   CTA
═══════════════════════════════════════════════════════════════════ #}
<section class="max-w-2xl mx-auto px-4 mb-10 text-center">
    <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Připraveno k&nbsp;použití</h2>
        <p class="text-gray-500 text-sm mb-6">Žádná registrace, žádná instalace. Stačí kliknout.</p>
        <a href="{{ path('upload_index') }}"
           class="inline-flex items-center gap-2 bg-indigo-600 text-white font-semibold px-8 py-3.5 rounded-2xl hover:bg-indigo-700 transition shadow-sm shadow-indigo-200">
            <i data-lucide="upload-cloud" class="w-5 h-5"></i>
            Nahrát soubor hned
        </a>
    </div>
</section>

{% endblock %}
